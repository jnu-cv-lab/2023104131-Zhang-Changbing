# 进阶任务：比较优化器
print("\n=== 进阶任务2：比较优化器 ===")
# 定义函数训练并返回准确率
def train_with_optimizer(optimizer_name, lr):
    model_temp = ImprovedCNN(input_channels, num_classes, img_size).to(device)
    criterion = nn.CrossEntropyLoss()
    if optimizer_name == 'SGD':
        opt = optim.SGD(model_temp.parameters(), lr=lr, momentum=0.9)
    else:
        opt = optim.Adam(model_temp.parameters(), lr=lr)
    # 简化训练，只跑5个epoch
    for epoch in range(5):
        model_temp.train()
        for images, labels in train_loader:
            images, labels = images.to(device), labels.to(device)
            opt.zero_grad()
            outputs = model_temp(images)
            loss = criterion(outputs, labels)
            loss.backward()
            opt.step()
    # 测试
    model_temp.eval()
    correct = 0
    total = 0
    with torch.no_grad():
        for images, labels in test_loader:
            images, labels = images.to(device), labels.to(device)
            outputs = model_temp(images)
            _, pred = torch.max(outputs, 1)
            total += labels.size(0)
            correct += (pred == labels).sum().item()
    acc = correct / total
    return acc

opt_results = []
for opt_name, lr in [('SGD', 0.01), ('Adam', 0.001)]:
    acc = train_with_optimizer(opt_name, lr)
    opt_results.append((opt_name, lr, acc))
print("优化器比较结果：")
print(f"{'Optimizer':<10} {'Learning Rate':<15} {'Test Accuracy':<15}")
for name, lr, acc in opt_results:
    print(f"{name:<10} {lr:<15} {acc:<15.4f}")

