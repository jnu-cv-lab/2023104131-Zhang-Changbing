# 任务3：定义 CNN 模型
print("\n=== 任务3：定义 CNN 模型 ===")

class SimpleCNN(nn.Module):
    """基础 CNN 模型"""
    def __init__(self, input_channels, num_classes, img_size):
        super(SimpleCNN, self).__init__()
        self.conv1 = nn.Conv2d(input_channels, 32, kernel_size=3, padding=1)
        self.relu1 = nn.ReLU()
        self.pool1 = nn.MaxPool2d(2, 2)   # 图像尺寸减半
        
        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)
        self.relu2 = nn.ReLU()
        self.pool2 = nn.MaxPool2d(2, 2)
        
        # 计算全连接层输入维度
        if DATASET == 'MNIST':
            fc_input = 64 * 7 * 7   # MNIST: 28->14->7
        else:
            fc_input = 64 * 8 * 8   # CIFAR-10: 32->16->8
        
        self.fc1 = nn.Linear(fc_input, 128)
        self.relu3 = nn.ReLU()
        self.fc2 = nn.Linear(128, num_classes)
    
    def forward(self, x):
        x = self.pool1(self.relu1(self.conv1(x)))
        x = self.pool2(self.relu2(self.conv2(x)))
        x = x.view(x.size(0), -1)
        x = self.relu3(self.fc1(x))
        x = self.fc2(x)
        return x

# 进阶任务1：改进网络结构（更深，带 dropout）
class ImprovedCNN(nn.Module):
    def __init__(self, input_channels, num_classes, img_size):
        super(ImprovedCNN, self).__init__()
        self.conv1 = nn.Conv2d(input_channels, 32, 3, padding=1)
        self.bn1 = nn.BatchNorm2d(32)
        self.relu1 = nn.ReLU()
        self.pool1 = nn.MaxPool2d(2)
        
        self.conv2 = nn.Conv2d(32, 64, 3, padding=1)
        self.bn2 = nn.BatchNorm2d(64)
        self.relu2 = nn.ReLU()
        self.pool2 = nn.MaxPool2d(2)
        
        self.conv3 = nn.Conv2d(64, 128, 3, padding=1)
        self.bn3 = nn.BatchNorm2d(128)
        self.relu3 = nn.ReLU()
        self.pool3 = nn.MaxPool2d(2)
        
        if DATASET == 'MNIST':
            fc_input = 128 * 3 * 3   # 28->14->7->3
        else:
            fc_input = 128 * 4 * 4   # 32->16->8->4
        
        self.fc1 = nn.Linear(fc_input, 256)
        self.dropout = nn.Dropout(0.5)
        self.fc2 = nn.Linear(256, num_classes)
    
    def forward(self, x):
        x = self.pool1(self.relu1(self.bn1(self.conv1(x))))
        x = self.pool2(self.relu2(self.bn2(self.conv2(x))))
        x = self.pool3(self.relu3(self.bn3(self.conv3(x))))
        x = x.view(x.size(0), -1)
        x = self.relu3(self.fc1(x))
        x = self.dropout(x)
        x = self.fc2(x)
        return x

# 选择使用哪个模型（基础或改进）
USE_IMPROVED = True   # 进阶任务1：尝试改进网络
if USE_IMPROVED:
    model = ImprovedCNN(input_channels, num_classes, img_size).to(device)
    print("使用改进 CNN 模型（3个卷积层 + BN + Dropout）")
else:
    model = SimpleCNN(input_channels, num_classes, img_size).to(device)
    print("使用基础 CNN 模型（2个卷积层）")
print(model)

# 任务4 & 5：训练与验证
print("\n=== 任务4 & 5：训练与验证 ===")
criterion = nn.CrossEntropyLoss()
# 进阶任务2：比较优化器
optimizer_name = 'Adam'   # 可选 'SGD', 'Adam'
if optimizer_name == 'SGD':
    optimizer = optim.SGD(model.parameters(), lr=0.01, momentum=0.9)
else:
    optimizer = optim.Adam(model.parameters(), lr=0.001)

num_epochs = 10
train_losses, train_accs = [], []
val_losses, val_accs = [], []

for epoch in range(num_epochs):
    # 训练阶段
    model.train()
    running_loss = 0.0
    correct = 0
    total = 0
    for images, labels in train_loader:
        images, labels = images.to(device), labels.to(device)
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        
        running_loss += loss.item() * images.size(0)
        _, predicted = torch.max(outputs, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()
    
    epoch_loss = running_loss / len(train_loader.dataset)
    epoch_acc = correct / total
    train_losses.append(epoch_loss)
    train_accs.append(epoch_acc)
    
    # 验证阶段
    model.eval()
    val_loss = 0.0
    val_correct = 0
    val_total = 0
    with torch.no_grad():
        for images, labels in val_loader:
            images, labels = images.to(device), labels.to(device)
            outputs = model(images)
            loss = criterion(outputs, labels)
            val_loss += loss.item() * images.size(0)
            _, predicted = torch.max(outputs, 1)
            val_total += labels.size(0)
            val_correct += (predicted == labels).sum().item()
    val_loss = val_loss / len(val_loader.dataset)
    val_acc = val_correct / val_total
    val_losses.append(val_loss)
    val_accs.append(val_acc)
    
    print(f"Epoch {epoch+1}/{num_epochs} | "
          f"Train Loss: {epoch_loss:.4f}, Train Acc: {epoch_acc:.4f} | "
          f"Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.4f}")

# 任务6：测试模型
print("\n=== 任务6：测试模型 ===")
