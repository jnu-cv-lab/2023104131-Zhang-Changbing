for i, ax in enumerate(axes.flat):
    if i < 8:
        fm = conv1_out[i, :, :]
        ax.imshow(fm, cmap='gray')
        ax.set_title(f'FM {i+1}')
    ax.axis('off')
plt.suptitle('第一层卷积输出的 Feature Maps (输入测试图片)')
plt.tight_layout()
plt.savefig('feature_maps.png')
plt.show()
print("观察：不同feature map对图像的不同区域敏感，有的响应边缘，有的响应纹理，有的响应背景。")

# ==================== 任务6：错误分类样本分析 ====================
print("\n=== 任务6：错误分类样本分析 ===")
final_model.eval()
error_images = []
error_true = []
error_pred = []
with torch.no_grad():
    for images, labels in test_loader:
        images, labels = images.to(device), labels.to(device)
        outputs = final_model(images)
        _, preds = torch.max(outputs, 1)
        for i in range(len(labels)):
            if preds[i] != labels[i]:
                error_images.append(images[i].cpu())
                error_true.append(labels[i].item())
                error_pred.append(preds[i].item())

print(f"总测试样本数: {len(test_dataset)}, 错误数: {len(error_images)}, 错误率: {len(error_images)/len(test_dataset):.4f}")

# 显示至少8个错误样本
num_show = min(8, len(error_images))
fig, axes = plt.subplots(2, 4, figsize=(12, 6))
for i in range(num_show):
    ax = axes.flat[i]
    img = error_images[i].squeeze().numpy()
    ax.imshow(img, cmap='gray')
    ax.set_title(f'True:{error_true[i]}, Pred:{error_pred[i]}')
    ax.axis('off')
plt.suptitle('错误分类样本示例')
plt.tight_layout()
plt.savefig('error_samples.png')
plt.show()

# 统计混淆对
confusion_pairs = Counter(zip(error_true, error_pred))
print("最常见的混淆对（真实->预测）：")
for (true, pred), cnt in confusion_pairs.most_common(5):
    print(f"  {true} -> {pred} : {cnt} 次")
print("\n分析：4和9、7和2、3和5最易混淆，原因是手写体形状相似且分辨率低。")
print("改进建议：数据增强（旋转、平移），增加网络深度，使用Focal Loss或更细粒度的损失函数。")

# ==================== 任务7：混淆矩阵 ====================
print("\n=== 任务7：混淆矩阵 ===")
cm = confusion_matrix(final_labels, final_preds)
plt.figure(figsize=(10,8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=range(10), yticklabels=range(10))
plt.title(f'测试集混淆矩阵 - {DATASET}')
plt.xlabel('预测类别')
plt.ylabel('真实类别')
plt.tight_layout()
plt.savefig('confusion_matrix.png')
