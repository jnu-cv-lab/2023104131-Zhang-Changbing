# 找出混淆最严重的两个类别（除对角线外）
off_diag = cm.copy()
np.fill_diagonal(off_diag, 0)
max_confusion = np.unravel_index(np.argmax(off_diag), off_diag.shape)
print(f"混淆最严重的类别对：{max_confusion[0]} 和 {max_confusion[1]}, 混淆次数 {off_diag[max_confusion]}")
print("对角线元素表示正确分类的样本数，非对角线表示错误分类。")

