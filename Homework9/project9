print("观察：部分卷积核呈现边缘检测（水平、垂直、斜向）或纹理模式，这些是通过反向传播从训练数据中自动学习得到的。")

# ==================== 任务5：Feature map 可视化 ====================
print("\n=== 任务5：Feature map 可视化 ===")
test_img, test_label = test_dataset[0]
test_img_tensor = test_img.unsqueeze(0).to(device)  # (1, C, H, W)

# 注册钩子获取第一层卷积输出（池化前）
activation = {}
def get_activation(name):
    def hook(model, input, output):
        activation[name] = output.detach()
    return hook
final_model.conv1.register_forward_hook(get_activation('conv1'))
_ = final_model(test_img_tensor)
conv1_out = activation['conv1'].squeeze(0).cpu().numpy()  # (32, H, W)

# 显示前8个 feature maps
